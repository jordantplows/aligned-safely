* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #000;
    color: #d4d4d4;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
}

.page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.banner {
    background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
    padding: 0.85rem 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
}

.banner-text {
    font-size: 0.85rem;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: 0.01em;
}

.banner-cta {
    font-size: 0.8rem;
    font-weight: 600;
    color: #c0392b;
    background: #ffffff;
    text-decoration: none;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    transition: all 0.2s;
    letter-spacing: 0.02em;
    white-space: nowrap;
}

.banner-cta:hover {
    background: #000000;
    color: #ffffff;
}

nav {
    padding: 1.25rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #1a1a1a;
}

.mark {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #525252;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.nav-link {
    font-size: 0.8rem;
    color: #e5e5e5;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s;
}

.nav-link:hover {
    color: #ffffff;
}

.sponsor-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #c0392b;
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid #c0392b;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
}

.sponsor-btn svg {
    flex-shrink: 0;
}

.sponsor-btn:hover {
    background: #c0392b;
    color: #fff;
}

.hero {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3rem;
}

.hero-img {
    width: min(92vw, 900px);
    height: auto;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
}

.content {
    padding: 3rem;
    max-width: 640px;
}

.rule {
    width: 32px;
    height: 1px;
    background: #c0392b;
    margin-bottom: 2rem;
}

.content p {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #ffffff;
    font-weight: 600;
    margin-bottom: 1.25rem;
}

.content .accent {
    color: #c0c0c0;
    font-weight: 500;
}

footer {
    background: #0a0a0a;
    border-top: 1px solid #1a1a1a;
    padding: 4rem 3rem 2rem;
}

.footer-main {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
    margin-bottom: 3rem;
}

.footer-column h4 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6a6a6a;
    margin-bottom: 1.5rem;
}

.footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.footer-links a {
    font-size: 0.85rem;
    color: #a0a0a0;
    text-decoration: none;
    transition: color 0.15s;
}

.footer-links a:hover {
    color: #ffffff;
}

.footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: 2rem;
    border-top: 1px solid #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
}

.footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer-logo {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #525252;
}

.footer-copyright {
    font-size: 0.75rem;
    color: #525252;
}

.footer-social {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.social-link {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6a6a6a;
    transition: color 0.15s;
}

.social-link:hover {
    color: #c0392b;
}

.social-link svg {
    width: 18px;
    height: 18px;
}

.footer-legal {
    display: flex;
    align-items: center;
    gap: 2rem;
}

.footer-legal a {
    font-size: 0.75rem;
    color: #6a6a6a;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.15s;
}

.footer-legal a:hover {
    color: #c0392b;
}

.footer-badges {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
}

.compliance-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    transition: border-color 0.2s;
}

.compliance-badge:hover {
    border-color: #c0392b;
}

.badge-icon-small {
    width: 24px;
    height: 24px;
    color: #c0392b;
}

.badge-label {
    font-size: 0.65rem;
    font-weight: 600;
    color: #8a8a8a;
    letter-spacing: 0.08em;
}

@media (max-width: 968px) {
    footer {
        padding: 3rem 2rem 2rem;
    }

    .footer-main {
        grid-template-columns: repeat(2, 1fr);
        gap: 2.5rem;
    }

    .footer-bottom {
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-legal {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .footer-badges {
        flex-wrap: wrap;
    }
}

.catalog {
    padding: 8rem 3rem;
    max-width: 1100px;
    margin: 0 auto;
}

.catalog-header {
    text-align: center;
    margin-bottom: 5rem;
}

.catalog-header h2 {
    font-size: 2.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
}

.catalog-intro {
    font-size: 1rem;
    color: #8a8a8a;
    font-weight: 400;
}

.aligned-info {
    max-width: 720px;
    margin: 0 auto 6rem;
    padding: 0 1rem;
}

.aligned-info h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
}

.aligned-info p {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin-bottom: 1.5rem;
}

.aligned-info p:last-child {
    margin-bottom: 0;
}

.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
}

.pricing-card {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s;
}

.pricing-card:hover {
    border-color: #3a3a3a;
}

.pricing-tier {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6a6a6a;
    margin-bottom: 1.5rem;
}

.pricing-amount {
    font-size: 3rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
}

.pricing-features {
    list-style: none;
    margin-bottom: 3rem;
    flex: 1;
}

.pricing-features li {
    font-size: 0.9rem;
    color: #a0a0a0;
    line-height: 2.2;
    padding-left: 0;
    margin-bottom: 0;
}

.pricing-cta {
    display: block;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    padding: 1rem;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    transition: all 0.2s;
    letter-spacing: 0.01em;
}

.pricing-cta:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
}

/* Form Styles */
.form-container {
    padding: 6rem 3rem;
    max-width: 720px;
    margin: 0 auto;
}

.form-header {
    margin-bottom: 3rem;
}

.form-header h2 {
    font-size: 2.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
}

.form-intro {
    font-size: 1rem;
    color: #8a8a8a;
    line-height: 1.6;
}

.bounty-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #a0a0a0;
    letter-spacing: 0.02em;
}

.form-group input,
.form-group textarea {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 0.85rem;
    font-size: 0.9rem;
    color: #ffffff;
    font-family: inherit;
    transition: border-color 0.2s;
}

.form-group input:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #c0392b;
}

.form-group textarea {
    resize: vertical;
    min-height: 120px;
}

.calendar-section {
    margin-top: 2rem;
    padding-top: 2rem;
}

.calendar-section h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
}

.calendar-section p {
    font-size: 0.9rem;
    color: #8a8a8a;
    margin-bottom: 1.25rem;
}

.calendar-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 500;
    color: #c0392b;
    text-decoration: none;
    transition: color 0.2s;
}

.calendar-link:hover {
    color: #e74c3c;
}

.form-submit {
    background: #ffffff;
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
}

.form-submit:hover:not(:disabled) {
    background: #c0392b;
    color: #ffffff;
}

.form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* Trust Center Styles */
.trust-hero {
    padding: 8rem 3rem 4rem;
    text-align: center;
}

.trust-container {
    max-width: 840px;
    margin: 0 auto;
}

.trust-title {
    font-size: 4rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1.5rem;
    letter-spacing: -0.04em;
}

.trust-subtitle {
    font-size: 1.25rem;
    color: #8a8a8a;
    line-height: 1.6;
}

.trust-content {
    padding: 4rem 3rem 8rem;
    max-width: 1000px;
    margin: 0 auto;
}

.trust-section {
    margin-bottom: 6rem;
}

.trust-section h2 {
    font-size: 2rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
}

.trust-section p {
    font-size: 1rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin-bottom: 1.5rem;
}

.badge-showcase {
    text-align: center;
    padding: 4rem 0;
}

.badge-container {
    margin-bottom: 3rem;
}

.asi-badge {
    display: inline-block;
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border: 2px solid #c0392b;
    border-radius: 50%;
    padding: 2rem;
}

.badge-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
}

.badge-icon {
    width: 64px;
    height: 64px;
    color: #c0392b;
    margin-bottom: 1rem;
}

.badge-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
}

.badge-subtext {
    font-size: 0.65rem;
    font-weight: 600;
    color: #6a6a6a;
    letter-spacing: 0.12em;
}

.badge-description {
    font-size: 0.95rem;
    color: #8a8a8a;
    max-width: 540px;
    margin: 0 auto;
}

.standards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-top: 2rem;
}

.standard-card {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 2rem;
}

.standard-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
}

.standard-card p {
    font-size: 0.9rem;
    color: #8a8a8a;
    line-height: 1.7;
    margin: 0;
}

.trust-cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 1rem 2rem;
    background: #ffffff;
    color: #000000;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.2s;
}

.trust-cta:hover {
    background: #c0392b;
    color: #ffffff;
}

/* Blog Styles */
.blog-hero {
    padding: 8rem 3rem 4rem;
    text-align: center;
}

.blog-hero-content {
    max-width: 840px;
    margin: 0 auto;
}

.blog-hero-title {
    font-size: 5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.5rem;
    letter-spacing: -0.04em;
}

.blog-hero-subtitle {
    font-size: 1.25rem;
    color: #8a8a8a;
    line-height: 1.6;
}

.blog-content {
    padding: 4rem 3rem 8rem;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
}

.blog-post {
    max-width: 720px;
}

.post-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
}

.post-category {
    color: #c0392b;
    font-weight: 600;
}

.post-date {
    color: #6a6a6a;
}

.blog-post h2 {
    font-size: 2.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 2rem;
    letter-spacing: -0.03em;
    line-height: 1.2;
}

.blog-post h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin: 3rem 0 1.5rem;
    letter-spacing: -0.02em;
}

.blog-post p {
    font-size: 1rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin-bottom: 1.5rem;
}

.blog-post ul {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
}

.blog-post li {
    font-size: 1rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin-bottom: 1rem;
}

.blog-post strong {
    color: #ffffff;
    font-weight: 600;
}

.post-cta {
    margin-top: 4rem;
    padding: 2.5rem;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    text-align: center;
}

.post-cta p {
    font-size: 1.1rem;
    color: #ffffff;
    margin-bottom: 1.5rem;
}

.blog-cta-button {
    display: inline-block;
    padding: 1rem 2rem;
    background: #c0392b;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.2s;
}

.blog-cta-button:hover {
    background: #e74c3c;
}

.blog-sidebar {
    position: sticky;
    top: 2rem;
    height: fit-content;
}

.sidebar-section {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 2rem;
}

.sidebar-section h4 {
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
}

.update-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
}

.update-item:last-child {
    margin-bottom: 0;
}

.update-date {
    font-size: 0.75rem;
    color: #6a6a6a;
    letter-spacing: 0.04em;
}

.update-title {
    font-size: 0.85rem;
    color: #a0a0a0;
}

@media (max-width: 968px) {
    .banner {
        flex-direction: column;
        gap: 1rem;
        padding: 1rem 2rem;
        text-align: center;
    }

    .banner-text {
        font-size: 0.8rem;
    }

    .catalog {
        padding: 6rem 2rem;
    }

    .pricing-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .pricing-card {
        padding: 2.5rem 2rem;
    }

    .form-container {
        padding: 4rem 2rem;
    }

    .trust-hero {
        padding: 6rem 2rem 3rem;
    }

    .trust-title {
        font-size: 3rem;
    }

    .trust-content {
        padding: 3rem 2rem 6rem;
    }

    .standards-grid {
        grid-template-columns: 1fr;
    }

    .blog-hero {
        padding: 6rem 2rem 3rem;
    }

    .blog-hero-title {
        font-size: 3.5rem;
    }

    .blog-content {
        grid-template-columns: 1fr;
        padding: 3rem 2rem 6rem;
    }

    .blog-sidebar {
        position: static;
    }
}

/* ASI-1 Page Styles */

/* Hero */
.asi-hero {
    padding: 8rem 3rem 6rem;
    text-align: center;
}

.asi-hero-content {
    max-width: 800px;
    margin: 0 auto;
}

.asi-hero-title {
    font-size: 6rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.5rem;
    letter-spacing: -0.04em;
}

.asi-hero-subtitle {
    font-size: 1.25rem;
    color: #8a8a8a;
    line-height: 1.6;
    margin-bottom: 3rem;
}

.asi-hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
}

.asi-btn-primary {
    display: inline-block;
    padding: 1rem 2rem;
    background: #c0392b;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.2s;
    letter-spacing: 0.02em;
}

.asi-btn-primary:hover {
    background: #e74c3c;
}

.asi-btn-secondary {
    display: inline-block;
    padding: 1rem 2rem;
    background: transparent;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    transition: all 0.2s;
    letter-spacing: 0.02em;
}

.asi-btn-secondary:hover {
    border-color: #c0392b;
    color: #c0392b;
}

/* Sections */
.asi-section {
    padding: 6rem 3rem;
}

.asi-section-alt {
    background: #0a0a0a;
}

.asi-section-cta {
    background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
}

.asi-container {
    max-width: 1200px;
    margin: 0 auto;
}

.asi-container-narrow {
    max-width: 840px;
    margin: 0 auto;
}

.asi-section-title {
    font-size: 2.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 2rem;
    letter-spacing: -0.03em;
    text-align: center;
}

/* Dual Blocks */
.asi-dual-blocks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
}

.asi-block {
    padding: 3rem;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
}

.asi-block h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
}

.asi-block p {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin-bottom: 1.5rem;
}

.asi-block p:last-child {
    margin-bottom: 0;
}

.asi-block-contrast {
    background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%);
}

.asi-risk-list {
    list-style: none;
    padding-left: 0;
}

.asi-risk-list li {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #a0a0a0;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    position: relative;
}

.asi-risk-list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #c0392b;
}

/* Profiles */
.asi-profiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
}

.asi-profile-card {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: border-color 0.2s;
}

.asi-profile-card:hover {
    border-color: #3a3a3a;
}

.asi-profile-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.4rem 0.85rem;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #c0392b;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.asi-profile-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
}

.asi-profile-card p {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin: 0;
}

/* Catalog */
.asi-catalog-header {
    text-align: center;
    margin-bottom: 4rem;
}

.asi-catalog-intro {
    font-size: 1rem;
    color: #8a8a8a;
    line-height: 1.7;
    max-width: 720px;
    margin: 0 auto;
}

/* Filters */
.asi-filters {
    display: flex;
    align-items: flex-end;
    gap: 3rem;
    margin-bottom: 3rem;
    padding: 2rem;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
}

.asi-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.asi-filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6a6a6a;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.asi-filter-buttons {
    display: flex;
    gap: 0.5rem;
}

.asi-filter-btn {
    padding: 0.6rem 1.25rem;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #a0a0a0;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    letter-spacing: 0.01em;
}

.asi-filter-btn:hover {
    border-color: #3a3a3a;
    color: #ffffff;
}

.asi-filter-btn.active {
    background: #c0392b;
    border-color: #c0392b;
    color: #ffffff;
}

.asi-filter-btn:focus-visible {
    outline: 2px solid #c0392b;
    outline-offset: 2px;
}

.asi-filter-select-wrapper {
    position: relative;
}

.asi-filter-select {
    padding: 0.6rem 2.5rem 0.6rem 1rem;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #a0a0a0;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    min-width: 200px;
    appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 12 12' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 4l4 4 4-4' stroke='%23a0a0a0' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
}

.asi-filter-select:hover {
    border-color: #3a3a3a;
    color: #ffffff;
}

.asi-filter-select:focus-visible {
    outline: 2px solid #c0392b;
    outline-offset: 2px;
    border-color: #c0392b;
}

.asi-filter-select option {
    background: #1a1a1a;
    color: #ffffff;
}

/* Controls Grid */
.asi-controls-grid {
    display: flex;
    flex-direction: column;
    gap: 4rem;
}

.asi-control-domain {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.asi-control-domain-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #8a8a8a;
    letter-spacing: -0.01em;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #2a2a2a;
}

.asi-control-card {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s;
}

.asi-control-card:hover {
    border-color: #3a3a3a;
}

.asi-control-header {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.asi-control-ref {
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    font-size: 0.85rem;
    font-weight: 600;
    color: #c0392b;
    background: #1a1a1a;
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    letter-spacing: 0.02em;
}

.asi-core-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    background: linear-gradient(135deg, #2a7a3e 0%, #1e5a2e 100%);
    border: 1px solid #3a8a4e;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.asi-control-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
}

.asi-control-criterion {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #a0a0a0;
    margin: 0;
}

.asi-control-criterion strong {
    color: #d4d4d4;
    font-weight: 600;
}

.asi-control-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid #1a1a1a;
}

.asi-control-meta-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
}

.asi-control-meta-label {
    font-size: 0.75rem;
    color: #6a6a6a;
    font-weight: 600;
    letter-spacing: 0.04em;
}

.asi-control-meta-value {
    font-size: 0.85rem;
    color: #8a8a8a;
}

.asi-no-results {
    text-align: center;
    font-size: 1rem;
    color: #6a6a6a;
    padding: 4rem 2rem;
}

/* Scoring */
.asi-scoring {
    padding: 2rem;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
}

.asi-maturity-scale {
    display: flex;
    justify-content: space-around;
    margin-bottom: 2rem;
    padding: 2rem;
    background: #000000;
    border-radius: 8px;
}

.asi-maturity-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.asi-maturity-level {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border: 2px solid #3a3a3a;
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
}

.asi-maturity-label {
    font-size: 0.8rem;
    color: #8a8a8a;
    font-weight: 500;
}

.asi-scoring p {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin-bottom: 1.5rem;
}

.asi-scoring p strong {
    color: #ffffff;
    font-weight: 600;
}

.asi-requirements {
    list-style: none;
    padding-left: 0;
    margin: 1.5rem 0;
}

.asi-requirements li {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #a0a0a0;
    padding-left: 2rem;
    margin-bottom: 0.75rem;
    position: relative;
}

.asi-requirements li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #2a7a3e;
    font-weight: 700;
}

.asi-scoring-note {
    font-size: 0.9rem;
    color: #6a6a6a;
    font-style: italic;
    margin-top: 2rem;
}

/* Process */
.asi-process {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 3rem;
}

.asi-process-step {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
}

.asi-process-number {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
}

.asi-process-content h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
}

.asi-process-content p {
    font-size: 0.95rem;
    line-height: 1.85;
    color: #a0a0a0;
    margin: 0;
}

.asi-process-note {
    margin-top: 2rem;
    padding: 1.5rem;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #8a8a8a;
}

.asi-process-note strong {
    color: #ffffff;
    font-weight: 600;
}

/* Standards */
.asi-standards-intro {
    font-size: 1rem;
    color: #a0a0a0;
    line-height: 1.7;
    text-align: center;
    margin-bottom: 3rem;
}

.asi-standards {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.asi-standard-item {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 2rem;
}

.asi-standard-item h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
}

.asi-standard-item p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #8a8a8a;
    margin-bottom: 1rem;
}

.asi-standard-link {
    font-size: 0.85rem;
    color: #c0392b;
    text-decoration: none;
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    letter-spacing: 0.01em;
    transition: color 0.2s;
}

.asi-standard-link:hover {
    color: #e74c3c;
}

.asi-disclaimer {
    margin-top: 3rem;
    padding: 1.5rem;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #6a6a6a;
    text-align: center;
}

/* Badge Showcase */
.asi-badge-showcase {
    text-align: center;
    padding: 3rem 0;
}

.asi-badge-specimen {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border: 3px solid #2a7a3e;
    border-radius: 50%;
    margin-bottom: 2rem;
    position: relative;
}

.asi-badge-icon {
    width: 64px;
    height: 64px;
    color: #2a7a3e;
    margin-bottom: 0.5rem;
}

.asi-badge-text {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
}

.asi-badge-year {
    font-size: 0.85rem;
    font-weight: 600;
    color: #6a6a6a;
}

.asi-badge-specimen-label {
    position: absolute;
    bottom: 1.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: #c0392b;
    letter-spacing: 0.12em;
}

.asi-badge-caption {
    font-size: 0.9rem;
    color: #8a8a8a;
    line-height: 1.7;
    max-width: 540px;
    margin: 0 auto;
}

/* Contact/CTA */
.asi-cta-intro {
    font-size: 1rem;
    color: #a0a0a0;
    line-height: 1.7;
    text-align: center;
    margin-bottom: 3rem;
}

.asi-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 3rem;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
}

.asi-contact-email {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.asi-contact-label {
    font-size: 0.85rem;
    color: #6a6a6a;
    font-weight: 600;
}

.asi-contact-value {
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    font-size: 1rem;
    color: #c0392b;
    background: #1a1a1a;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    letter-spacing: 0.01em;
}

.asi-copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    color: #8a8a8a;
    cursor: pointer;
    transition: all 0.2s;
}

.asi-copy-btn:hover {
    border-color: #c0392b;
    color: #c0392b;
}

.asi-copy-btn:focus-visible {
    outline: 2px solid #c0392b;
    outline-offset: 2px;
}

.asi-contact-note {
    font-size: 0.85rem;
    color: #6a6a6a;
    margin: 0;
}

/* Responsive */
@media (max-width: 968px) {
    .asi-hero {
        padding: 6rem 2rem 4rem;
    }

    .asi-hero-title {
        font-size: 4rem;
    }

    .asi-section {
        padding: 4rem 2rem;
    }

    .asi-dual-blocks {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .asi-profiles {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .asi-filters {
        flex-direction: column;
        align-items: stretch;
        gap: 1.5rem;
    }

    .asi-filter-buttons {
        flex-wrap: wrap;
    }

    .asi-filter-select {
        width: 100%;
    }

    .asi-process-step {
        gap: 1.5rem;
    }

    .asi-process-number {
        width: 40px;
        height: 40px;
        font-size: 1rem;
    }

    .asi-contact-email {
        flex-direction: column;
        text-align: center;
    }
}

@media (max-width: 480px) {
    .asi-hero-title {
        font-size: 3rem;
    }

    .asi-hero-actions {
        flex-direction: column;
        width: 100%;
    }

    .asi-btn-primary,
    .asi-btn-secondary {
        width: 100%;
    }

    .asi-control-card {
        padding: 1.5rem;
    }

    .asi-maturity-scale {
        padding: 1rem;
    }

    .asi-maturity-level {
        width: 40px;
        height: 40px;
        font-size: 1rem;
    }

    .asi-maturity-label {
        font-size: 0.7rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    .asi-filter-btn,
    .asi-filter-select,
    .asi-control-card,
    .asi-copy-btn,
    .asi-btn-primary,
    .asi-btn-secondary,
    .asi-profile-card,
    .asi-standard-link {
        transition: none;
    }
}

/* Assessment-specific styles */
.asi-assessment-intro {
    font-size: 1rem;
    color: #a0a0a0;
    line-height: 1.85;
    margin-bottom: 3rem;
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
}

.asi-assessment-intro strong {
    color: #ffffff;
    font-weight: 600;
}

.asi-data-notice {
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 3rem;
}

.asi-data-notice h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
}

.asi-data-notice p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #8a8a8a;
    margin: 0;
}

/* Profile form */
.asi-profile-form {
    display: flex;
    flex-direction: column;
    gap: 3rem;
}

.asi-profile-form fieldset {
    border: none;
    padding: 0;
    margin: 0;
}

.asi-form-legend {
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
}

.asi-form-help {
    font-size: 0.9rem;
    color: #8a8a8a;
    line-height: 1.7;
    margin-bottom: 2rem;
}

.asi-profile-options {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.asi-profile-option {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 2rem;
    background: transparent;
    border: 2px solid #2a2a2a;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
}

.asi-profile-option:hover {
    border-color: #3a3a3a;
}

.asi-profile-option:has(input:checked) {
    border-color: #c0392b;
    background: rgba(192, 57, 43, 0.05);
}

.asi-profile-option:has(input:focus-visible) {
    outline: 2px solid #c0392b;
    outline-offset: 2px;
}

.asi-profile-option input[type="radio"] {
    width: 20px;
    height: 20px;
    margin-top: 0.25rem;
    accent-color: #c0392b;
    cursor: pointer;
}

.asi-profile-option-content {
    flex: 1;
}

.asi-profile-option-header {
    margin-bottom: 0.75rem;
}

.asi-profile-option-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c0392b;
    background: rgba(192, 57, 43, 0.1);
    padding: 0.4rem 0.85rem;
    border-radius: 4px;
}

.asi-profile-option-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #a0a0a0;
    margin: 0;
}

.asi-agents-fieldset {
    margin-top: 1rem;
}

.asi-radio-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.asi-radio-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
}

.asi-radio-label:hover {
    border-color: #3a3a3a;
}

.asi-radio-label:has(input:checked) {
    border-color: #c0392b;
    background: rgba(192, 57, 43, 0.05);
}

.asi-radio-label:has(input:focus-visible) {
    outline: 2px solid #c0392b;
    outline-offset: 2px;
}

.asi-radio-label input[type="radio"] {
    width: 18px;
    height: 18px;
    accent-color: #c0392b;
    cursor: pointer;
}

.asi-radio-label span {
    font-size: 0.9rem;
    color: #d4d4d4;
}

/* Questionnaire */
.asi-questionnaire-header {
    margin-bottom: 3rem;
}

.asi-progress-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
}

.asi-questionnaire-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
}

.asi-progress-text {
    font-size: 0.85rem;
    color: #6a6a6a;
    font-weight: 500;
}

.asi-progress-bar {
    width: 100%;
    height: 6px;
    background: #1a1a1a;
    border-radius: 3px;
    overflow: hidden;
}

.asi-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #c0392b 0%, #e74c3c 100%);
    transition: width 0.3s ease;
}

.asi-question-form fieldset {
    border: none;
    padding: 0;
    margin: 0;
}

.asi-question-legend {
    width: 100%;
    margin-bottom: 2rem;
}

.asi-question-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.asi-question-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
}

.asi-question-criterion {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #8a8a8a;
    margin-bottom: 2rem;
    padding: 1.25rem;
    background: #0a0a0a;
    border-left: 3px solid #2a2a2a;
    border-radius: 4px;
}

.asi-question-criterion strong {
    color: #a0a0a0;
}

.asi-maturity-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
}

.asi-maturity-option {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background: transparent;
    border: 2px solid #2a2a2a;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s;
}

.asi-maturity-option:hover {
    border-color: #3a3a3a;
}

.asi-maturity-option:has(input:checked) {
    border-color: #c0392b;
    background: rgba(192, 57, 43, 0.05);
}

.asi-maturity-option:has(input:focus-visible) {
    outline: 2px solid #c0392b;
    outline-offset: 2px;
}

.asi-maturity-option input[type="radio"] {
    width: 20px;
    height: 20px;
    accent-color: #c0392b;
    cursor: pointer;
}

.asi-maturity-option-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
}

.asi-maturity-option .asi-maturity-level {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
    border: 2px solid #3a3a3a;
    border-radius: 50%;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
}

.asi-maturity-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.asi-maturity-option .asi-maturity-label {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
}

.asi-maturity-desc {
    font-size: 0.85rem;
    color: #6a6a6a;
}

.asi-maturity-option-unsure {
    border-style: dashed;
}

.asi-maturity-option-unsure .asi-maturity-details {
    padding-left: 0;
}

.asi-question-notes {
    margin-bottom: 2rem;
}

.asi-notes-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: #a0a0a0;
    margin-bottom: 0.5rem;
}

.asi-notes-textarea {
    width: 100%;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 0.85rem;
    font-size: 0.9rem;
    color: #ffffff;
    font-family: inherit;
    line-height: 1.6;
    transition: border-color 0.2s;
    resize: vertical;
}

.asi-notes-textarea:focus {
    outline: none;
    border-color: #c0392b;
}

.asi-notes-textarea::placeholder {
    color: #4a4a4a;
}

.asi-question-actions {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 2rem;
}

.asi-questionnaire-meta {
    padding: 1.5rem;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    font-size: 0.85rem;
    color: #6a6a6a;
}

.asi-questionnaire-meta p {
    margin: 0.5rem 0;
}

.asi-questionnaire-meta strong {
    color: #8a8a8a;
    font-weight: 600;
}

/* Results */
.asi-result-header {
    margin-bottom: 3rem;
}

.asi-result-disclaimer {
    background: rgba(192, 57, 43, 0.1);
    border: 2px solid #c0392b;
    border-radius: 8px;
    padding: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #d4d4d4;
    margin-top: 1.5rem;
}

.asi-result-disclaimer strong {
    color: #ffffff;
    font-weight: 600;
}

.asi-result-summary {
    background: #0a0a0a;
    border: 2px solid #2a2a2a;
    border-radius: 12px;
    padding: 3rem;
    margin-bottom: 3rem;
}

.asi-result-ready {
    border-color: #2a7a3e;
}

.asi-result-not-ready {
    border-color: #c0392b;
}

.asi-result-status {
    text-align: center;
    margin-bottom: 3rem;
}

.asi-result-status-title {
    font-size: 2rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
}

.asi-result-status-desc {
    font-size: 1rem;
    line-height: 1.7;
    color: #a0a0a0;
    max-width: 600px;
    margin: 0 auto;
}

.asi-result-status-desc strong {
    color: #ffffff;
    font-weight: 600;
}

.asi-result-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
}

.asi-result-metric {
    text-align: center;
    padding: 2rem;
    background: #000000;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
}

.asi-result-metric-value {
    font-size: 3rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
}

.asi-result-metric-label {
    font-size: 0.9rem;
    color: #a0a0a0;
    margin-bottom: 0.5rem;
}

.asi-result-metric-note {
    font-size: 0.8rem;
    color: #6a6a6a;
    font-style: italic;
}

.asi-result-section {
    margin-bottom: 3rem;
}

.asi-result-section-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
}

.asi-result-section-desc {
    font-size: 0.9rem;
    color: #8a8a8a;
    margin-bottom: 2rem;
}

.asi-result-domains {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.asi-result-domain {
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 1.5rem;
}

.asi-result-domain-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
}

.asi-result-domain-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
}

.asi-result-domain-score {
    font-size: 0.85rem;
    color: #8a8a8a;
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
}

.asi-result-domain-bar {
    width: 100%;
    height: 8px;
    background: #1a1a1a;
    border-radius: 4px;
    overflow: hidden;
}

.asi-result-domain-fill {
    height: 100%;
    background: linear-gradient(90deg, #2a7a3e 0%, #3a9a4e 100%);
}

.asi-gaps-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.asi-gap-item {
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-left: 4px solid #5a5a5a;
    border-radius: 8px;
    padding: 1.5rem;
}

.asi-gap-core {
    border-left-color: #c0392b;
}

.asi-gap-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
}

.asi-gap-name {
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.75rem;
}

.asi-gap-criterion {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #8a8a8a;
    margin: 0;
}

.asi-gap-criterion strong {
    color: #a0a0a0;
}

.asi-no-gaps {
    text-align: center;
    padding: 3rem;
    font-size: 1rem;
    color: #6a6a6a;
}

.asi-result-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.asi-result-footer {
    margin-top: 3rem;
    text-align: center;
}

.asi-btn-link {
    background: none;
    border: none;
    color: #8a8a8a;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.2s;
}

.asi-btn-link:hover {
    color: #c0392b;
}

/* Modal */
.asi-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
}

.asi-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
}

.asi-modal-content {
    position: relative;
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 3rem;
    max-width: 560px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
}

.asi-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    color: #8a8a8a;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s;
}

.asi-modal-close:hover {
    color: #ffffff;
}

.asi-modal-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
}

.asi-modal-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #8a8a8a;
    margin-bottom: 2rem;
}

.asi-lead-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.asi-checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
}

.asi-checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 0.15rem;
    accent-color: #c0392b;
    cursor: pointer;
}

.asi-checkbox-label span {
    font-size: 0.9rem;
    color: #a0a0a0;
    line-height: 1.6;
}

.asi-modal-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
}

.asi-lead-result-message {
    font-size: 0.95rem;
    color: #a0a0a0;
    line-height: 1.7;
    margin-bottom: 1.5rem;
}

.asi-lead-result-note {
    font-size: 0.85rem;
    color: #6a6a6a;
    line-height: 1.6;
    margin-top: 1.5rem;
}

/* Responsive for assessment */
@media (max-width: 968px) {
    .asi-profile-options {
        gap: 1.25rem;
    }

    .asi-profile-option {
        flex-direction: column;
        gap: 1rem;
    }

    .asi-profile-option input[type="radio"] {
        margin-top: 0;
    }

    .asi-maturity-options {
        gap: 0.75rem;
    }

    .asi-maturity-option {
        padding: 1.25rem;
        gap: 1rem;
    }

    .asi-maturity-option-content {
        gap: 1rem;
    }

    .asi-maturity-option .asi-maturity-level {
        width: 40px;
        height: 40px;
        font-size: 1.1rem;
    }

    .asi-question-actions {
        flex-direction: column-reverse;
    }

    .asi-result-summary {
        padding: 2rem;
    }

    .asi-result-metrics {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .asi-result-actions {
        flex-direction: column;
        width: 100%;
    }

    .asi-result-actions button {
        width: 100%;
    }

    .asi-modal-content {
        padding: 2rem;
    }

    .asi-modal-actions {
        flex-direction: column-reverse;
    }

    .asi-modal-actions button {
        width: 100%;
    }
}

@media (max-width: 480px) {
    .asi-progress-header {
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
    }

    .asi-result-metric-value {
        font-size: 2.5rem;
    }

    .asi-result-domain-header {
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
    }

    .asi-gap-header {
        flex-wrap: wrap;
    }
}

@media (prefers-reduced-motion: reduce) {
    .asi-progress-fill,
    .asi-profile-option,
    .asi-radio-label,
    .asi-maturity-option,
    .asi-notes-textarea,
    .asi-btn-link,
    .asi-modal-close {
        transition: none;
    }
}
