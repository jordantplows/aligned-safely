# Application
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.alignedsafely.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/alignedsafely
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d

# Email (SendGrid, AWS SES, or SMTP)
EMAIL_FROM=noreply@alignedsafely.com
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG...

# AWS (if using AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=https://alignedsafely.com,https://www.alignedsafely.com

# Feature Flags
ENABLE_MONITORING=true
ENABLE_WEBHOOKS=true
